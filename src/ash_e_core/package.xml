<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ash_e_core</name>
  <version>0.1.0</version>
  <description>ASH-E core: ROS-free perception and priority logic (also pip installable).</description>
  <maintainer email="todo@example.com">ASH-E</maintainer>
  <license>Proprietary</license>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <!-- onnxruntime is not a rosdep key: pip install onnxruntime -->
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
